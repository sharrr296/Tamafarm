# Alamat API Laravel. Kosongkan saat development (dipakai proxy Vite ke /api).
# Untuk production isi lengkap, contoh: https://api.tamafarm.com/api
VITE_API_URL=

# Nomor WhatsApp untuk tombol pesan (format internasional tanpa +, contoh: 6281234567890).
# Kosongkan jika belum ada, tombolnya otomatis disembunyikan.
VITE_WHATSAPP=
